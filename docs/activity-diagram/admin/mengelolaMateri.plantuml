@startuml
|Admin|
start
:Mengakses Menu Kelola Materi / Kuis;

|Sistem LMS|
:Eksekusi Native Query (SELECT seluruh konten);
:Menampilkan Daftar Konten;

|Admin|
:Mencari dan Memilih Konten untuk Dimoderasi;
:Memilih Aksi (Sembunyikan, Hapus Paksa);

|Sistem LMS|
:Menerima Perintah Moderasi;
if (Aksi yang Dipilih?) then (Hapus Paksa)
  :Eksekusi Native Query (DELETE data);
  :Hapus Aset File dari AWS S3 (Jika ada);
else (Sembunyikan)
  :Eksekusi Native Query (UPDATE status_publik = false);
endif

:Kirim Notifikasi Otomatis ke Creator Konten;
:Menampilkan Pemberitahuan Sukses;

|Admin|
:Kembali ke Halaman Moderasi;
stop
@enduml