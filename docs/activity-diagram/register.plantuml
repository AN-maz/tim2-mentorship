@startuml
|Pengguna|
start
:Membuka Halaman Registrasi;
if (Pilih Metode Daftar?) then (Manual)
  :Mengisi Form (Nama, Email, Password);
  
  |Sistem LMS|
  :Validasi Format Input & Enkripsi Password;
  
else (Google Auth)
  |Pengguna|
  :Klik "Daftar via Google";
  
  |Google Auth|
  :Otentikasi & Ekstrak Data Profil;
  
  |Sistem LMS|
  :Mengambil Data Profil;
endif

|Sistem LMS|
:Pengecekan Ketersediaan Email di Database;
if (Email Sudah Terdaftar?) then (Ya)
  :Tampilkan Pesan Error "Email Sudah Digunakan";
  |Pengguna|
  :Kembali ke Form Registrasi;
  stop
else (Belum)
  |Sistem LMS|
  :Simpan Data Pengguna Baru (Native Query Insert);
  :Kirim Notifikasi Pembuatan Akun Sukses;
  :Arahkan ke Halaman Login;
  stop
endif
@enduml