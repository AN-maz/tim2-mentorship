@startuml
|Pengguna|
start
:Mengakses Halaman Daftar Materi;

if (Gunakan Fitur Pencarian?) then (Ya)
  :Memasukkan Kata Kunci Pencarian;
  
  |Sistem LMS|
  :Eksekusi Native Query (Pencarian Teks);
  :Tampilkan Hasil Pencarian;
  
  |Pengguna|
else (Tidak)
endif

:Memilih Judul Materi;

|Sistem LMS|
:Mengambil Data Materi;
:Merender Konten Markdown ke Tampilan UI;
:Menampilkan Halaman Detail Materi;

|Pengguna|
:Melihat Detail Materi;

fork
  :Memberikan Bintang (Rating);
  |Sistem LMS|
  :Simpan Nilai Rating (Native Query);
fork again
  |Pengguna|
  :Menulis Komentar;
  |Sistem LMS|
  :Simpan Data Komentar (Native Query);
fork again
  |Pengguna|
  :Hanya Membaca Sekilas;
end fork

|Pengguna|
:Menutup Halaman Detail;
stop
@enduml